# =============================================================================
# AI Resume Screening - environment template
# Copy this file to .env and fill in your real values.
# Never commit .env to git.
# =============================================================================

# Flask
# Generate a strong random key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_strong_random_secret
FLASK_ENV=development
PORT=5000

# Groq API
# Get your key at https://console.groq.com
GROQ_API_KEY=replace_with_your_groq_api_key

# ML model paths
SCORER_PKL_PATH=resume_scorer_pipeline.pkl
ROLE_CLASSIFIER_PKL_PATH=role_classifier.pkl

# Database
# Leave unset to use the default local SQLite database.
# DATABASE_URL=postgresql://username:password@localhost:5432/resumeai
# SQLALCHEMY_DATABASE_URI=sqlite:///resumeai.db

# Email provider examples
# SENDGRID_API_KEY=replace_with_your_sendgrid_key
# MAILGUN_API_KEY=replace_with_your_mailgun_key
# MAILGUN_DOMAIN=mg.yourdomain.com
# AWS_ACCESS_KEY_ID=replace_with_aws_key
# AWS_SECRET_ACCESS_KEY=replace_with_aws_secret
# AWS_REGION=ap-south-1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=your_email@example.com

# Duplicate detection
DUPLICATE_SIMILARITY_THRESHOLD=0.92

# CORS
# Comma-separated if more than one origin.
CORS_ORIGIN=http://localhost:5000

# Optional sentence-transformers cache
# TRANSFORMERS_CACHE=/path/to/your/cache
